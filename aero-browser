#!/usr/bin/env python3
"""
AeroOS Native Web Browser (aero-browser)
A lightweight, minimal, tabbed Wayland browser built on PyQt5 QtWebEngine.
"""

import argparse
import sys
from pathlib import Path

try:
    from PyQt5.QtCore import QSize, Qt, QUrl
    from PyQt5.QtGui import QColor, QKeySequence
    from PyQt5.QtWebEngineWidgets import QWebEnginePage, QWebEngineProfile, QWebEngineSettings, QWebEngineView
    from PyQt5.QtWidgets import (
        QAction,
        QApplication,
        QHBoxLayout,
        QLabel,
        QLineEdit,
        QMainWindow,
        QPushButton,
        QShortcut,
        QTabWidget,
        QToolBar,
        QVBoxLayout,
        QWidget,
    )
except ImportError as exc:
    print(f"[-] aero-browser requires PyQt5 and PyQtWebEngine: {exc}", file=sys.stderr)
    sys.exit(1)


HOME_URL = "https://duckduckgo.com"

AERO_STYLESHEET = """
QMainWindow {
    background-color: #071422;
    color: #f0f9ff;
}
QToolBar {
    background-color: #0a1c2e;
    border-bottom: 1px solid #1b3b5a;
    spacing: 6px;
    padding: 6px 10px;
}
QPushButton#navBtn {
    background-color: #0f273d;
    color: #dbeafe;
    border: 1px solid #1e4264;
    border-radius: 7px;
    padding: 5px 10px;
    font-weight: 600;
    min-width: 28px;
}
QPushButton#navBtn:hover {
    background-color: #163754;
    border-color: #38bdf8;
    color: #ffffff;
}
QLineEdit#urlBar {
    background-color: #06111c;
    color: #f0f9ff;
    border: 1px solid #1e4264;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 13px;
    selection-background-color: #38bdf8;
    selection-color: #06131f;
