"""


def normalize_url(raw: str) -> QUrl:
    text = raw.strip()
    if not text:
        return QUrl(HOME_URL)
    if "://" in text:
        return QUrl(text)
    if "." in text and " " not in text:
        return QUrl("https://" + text)
    return QUrl(f"https://duckduckgo.com/?q={QUrl.toPercentEncoding(text).data().decode('ascii')}")


class AeroBrowserWindow(QMainWindow):
    def __init__(self, initial_url: str = HOME_URL):
        super().__init__()
        self.setWindowTitle("Aero Browser")
        self.resize(1240, 820)
        self.setStyleSheet(AERO_STYLESHEET)

        self.profile = QWebEngineProfile.defaultProfile()
        storage_dir = Path.home() / ".local" / "share" / "aeroos" / "browser"
        storage_dir.mkdir(parents=True, exist_ok=True)
        self.profile.setPersistentStoragePath(str(storage_dir))
        self.profile.setCachePath(str(storage_dir / "cache"))

        settings = self.profile.settings()
        settings.setAttribute(QWebEngineSettings.PluginsEnabled, False)
        settings.setAttribute(QWebEngineSettings.JavascriptCanAccessClipboard, False)
        settings.setAttribute(QWebEngineSettings.LocalStorageEnabled, True)
        settings.setAttribute(QWebEngineSettings.ScrollAnimatorEnabled, True)

        self.tabs = QTabWidget()
        self.tabs.setDocumentMode(True)
        self.tabs.setTabsClosable(True)
        self.tabs.tabCloseRequested.connect(self.close_tab)
        self.tabs.currentChanged.connect(self.sync_url_bar)

        toolbar = QToolBar("Navigation")
        toolbar.setMovable(False)
        toolbar.setIconSize(QSize(16, 16))
        self.addToolBar(toolbar)

        self.back_btn = QPushButton("←")
        self.back_btn.setObjectName("navBtn")
        self.back_btn.setToolTip("Back (Alt+Left)")
        self.back_btn.clicked.connect(lambda: self.current_view() and self.current_view().back())

        self.fwd_btn = QPushButton("→")
        self.fwd_btn.setObjectName("navBtn")
        self.fwd_btn.setToolTip("Forward (Alt+Right)")
        self.fwd_btn.clicked.connect(lambda: self.current_view() and self.current_view().forward())

        self.reload_btn = QPushButton("↻")
        self.reload_btn.setObjectName("navBtn")
        self.reload_btn.setToolTip("Reload (Ctrl+R)")
        self.reload_btn.clicked.connect(lambda: self.current_view() and self.current_view().reload())

        self.home_btn = QPushButton("⌂")
        self.home_btn.setObjectName("navBtn")
        self.home_btn.setToolTip("Home")
        self.home_btn.clicked.connect(lambda: self.navigate_to(HOME_URL))

        self.tls_badge = QLabel("HTTPS")
        self.tls_badge.setObjectName("tlsBadge")

        self.url_bar = QLineEdit()
        self.url_bar.setObjectName("urlBar")
        self.url_bar.setPlaceholderText("Search DuckDuckGo or enter URL...")
        self.url_bar.returnPressed.connect(self.on_url_submitted)

        self.new_tab_btn = QPushButton("+")
        self.new_tab_btn.setObjectName("navBtn")
        self.new_tab_btn.setToolTip("New Tab (Ctrl+T)")
        self.new_tab_btn.clicked.connect(lambda: self.add_tab(HOME_URL))

        for w in (self.back_btn, self.fwd_btn, self.reload_btn, self.home_btn, self.tls_badge, self.url_bar, self.new_tab_btn):
            toolbar.addWidget(w)

        container = QWidget()
        layout = QVBoxLayout(container)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.addWidget(self.tabs)
        self.setCentralWidget(container)

        QShortcut(QKeySequence("Ctrl+T"), self, activated=lambda: self.add_tab(HOME_URL))
        QShortcut(QKeySequence("Ctrl+W"), self, activated=lambda: self.close_tab(self.tabs.currentIndex()))
        QShortcut(QKeySequence("Ctrl+L"), self, activated=self.focus_url_bar)
        QShortcut(QKeySequence("Ctrl+R"), self, activated=lambda: self.current_view() and self.current_view().reload())

        self.add_tab(initial_url)

    def focus_url_bar(self):
        self.url_bar.setFocus()
        self.url_bar.selectAll()

    def current_view(self):
        return self.tabs.currentWidget()

    def add_tab(self, url: str = HOME_URL):
        view = QWebEngineView()
        page = QWebEnginePage(self.profile, view)
        view.setPage(page)
        view.page().setBackgroundColor(QColor("#071422"))
        view.load(normalize_url(url))

        idx = self.tabs.addTab(view, "New Tab")
        self.tabs.setCurrentIndex(idx)

        view.titleChanged.connect(lambda title, v=view: self.update_tab_title(v, title))
        view.urlChanged.connect(lambda qurl, v=view: self.on_view_url_changed(v, qurl))
        return view

    def close_tab(self, idx: int):
        if self.tabs.count() <= 1:
            self.close()
            return
        widget = self.tabs.widget(idx)
        self.tabs.removeTab(idx)
        if widget:
            widget.deleteLater()

    def update_tab_title(self, view: QWebEngineView, title: str):
        idx = self.tabs.indexOf(view)
        if idx >= 0:
            short = (title or "Tab")[:24]
            self.tabs.setTabText(idx, short)
            if idx == self.tabs.currentIndex():
                self.setWindowTitle(f"{title or 'Aero Browser'} — Aero Browser")

    def on_view_url_changed(self, view: QWebEngineView, qurl: QUrl):
        if view == self.current_view():
            self.update_url_display(qurl)

    def sync_url_bar(self, idx: int):
        view = self.tabs.widget(idx)
        if view:
            self.update_url_display(view.url())
            self.setWindowTitle(f"{view.title() or 'Aero Browser'} — Aero Browser")

    def update_url_display(self, qurl: QUrl):
        self.url_bar.setText(qurl.toString())
        if qurl.scheme() == "https":
            self.tls_badge.setText("HTTPS")
            self.tls_badge.setStyleSheet("color: #34d399; font-weight: 600; padding: 0 6px;")
        elif qurl.scheme() == "http":
            self.tls_badge.setText("HTTP")
            self.tls_badge.setStyleSheet("color: #fbbf24; font-weight: 600; padding: 0 6px;")
        else:
            self.tls_badge.setText("LOCAL")
            self.tls_badge.setStyleSheet("color: #38bdf8; font-weight: 600; padding: 0 6px;")

    def on_url_submitted(self):
        self.navigate_to(self.url_bar.text())

    def navigate_to(self, raw: str):
        view = self.current_view()
        if view:
            view.load(normalize_url(raw))


def main() -> int:
    parser = argparse.ArgumentParser(description="AeroOS Native Web Browser")
    parser.add_argument("url", nargs="?", default=HOME_URL, help="Initial URL to open")
    args = parser.parse_args()

    app = QApplication(["aero-browser"])
    app.setApplicationName("aero-browser")
    win = AeroBrowserWindow(args.url)
    win.show()
    return app.exec_()


if __name__ == "__main__":
    sys.exit(main())
