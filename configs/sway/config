# AeroOS Sway Configuration File
# Location: ~/.config/sway/config

# Logo key (Super / Windows key)
set $mod Mod4

# Home Row Directions
set $left h
set $down j
set $up k
set $right l

# Preferred Terminal & Browser
set $term kitty
set $browser brave-browser

# Preferred App Launcher (User-friendly Wofi)
set $menu wofi --show drun --prompt "Launch Application..." --allow-images

### Output & Input Configuration
# Default wallpaper (overridden by active theme in ~/.config/sway/theme)
output * bg /usr/share/aeroos/wallpapers/aero-glass.jpg fill

input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
}

### Key Bindings
# Start a terminal
bindsym $mod+Return exec $term

# Kill focused window
bindsym $mod+q kill

# Start your launcher
bindsym $mod+space exec $menu
bindsym $mod+d exec $menu

# Drag floating windows by holding down $mod and left mouse button.
# Resize them with right mouse button.
floating_modifier $mod normal

# Reload the configuration file
bindsym $mod+Shift+c reload

# Exit sway (logs you out of your Wayland session)
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit Sway?' -B 'Yes, exit Sway' 'swaymsg exit'

# Focus movement
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

# Move focused window
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

# Arrow key focus & move fallbacks
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Layout tweaks
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+b splith
bindsym $mod+v splitv

# Custom AeroOS Tool Keybinds
bindsym $mod+a exec aero-hub
bindsym $mod+Shift+b exec aero-browser
bindsym $mod+w exec aero-webapp menu
bindsym $mod+Shift+t exec aero-theme --menu
bindsym $mod+Shift+p exec aero-power
bindsym $mod+Ctrl+l exec swaylock -C ~/.config/swaylock/config
bindsym $mod+s exec /usr/local/bin/bauh
bindsym $mod+i exec sudo calamares -d
bindsym $mod+e exec thunar

# Media & Volume Keybinds (Gamer & Laptop friendly)
bindsym XF86AudioRaiseVolume exec pamixer -i 5
bindsym XF86AudioLowerVolume exec pamixer -d 5
bindsym XF86AudioMute exec pamixer -t
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# Screenshot tools (Grim + Slurp)
bindsym Print exec grim -g "$(slurp)" - | wl-copy && notify-send "Screenshot Copied" "Selection copied to clipboard."
bindsym $mod+Shift+Print exec mkdir -p ~/Pictures/Screenshots && grim ~/Pictures/Screenshots/aeroos-$(date +%Y%m%d-%H%M%S).png && notify-send "Screenshot Saved" "Saved to ~/Pictures/Screenshots/"

### Aesthetics (Gaps and Borders)
gaps inner 8
gaps outer 4
default_border pixel 2
default_floating_border normal
smart_borders on
smart_gaps on

### Window Rules for AeroOS Modern Tools & Popups
for_window [app_id="aero-hub"] floating enable, resize set 1120 720, move position center
for_window [title="AeroOS Control Hub.*"] floating enable, resize set 1120 720, move position center
for_window [app_id="pavucontrol"] floating enable, resize set 760 500, move position center
for_window [app_id="blueman-manager"] floating enable, resize set 680 460, move position center
for_window [app_id="nm-connection-editor"] floating enable, move position center
for_window [title="Picture-in-Picture"] floating enable, sticky enable

# Include dynamic theme settings (window borders, wallpaper)
include theme

### Autostart Services
exec /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1
exec waybar
exec mako
exec nm-applet --indicator
exec blueman-applet
exec swayidle -w \
    timeout 600 'swaylock -f -C ~/.config/swaylock/config' \
    timeout 900 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f -C ~/.config/swaylock/config'
